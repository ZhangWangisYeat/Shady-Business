# Public token for rendering Mapbox maps (pk...). Scope to minimal public map access.
EXPO_PUBLIC_MAPBOX_TOKEN=pk_REPLACE_ME
# Device must reach backend over LAN (do not use localhost for physical phones)
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
# Native SDK artifact download secret (sk...) belongs OUTSIDE .env, in secure EAS secrets or user-level .netrc / Gradle settings.
