{
  "name": "shady-business-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "doctor": "expo-doctor",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@rnmapbox/maps": "^10.2.0",
    "expo": "~57.0.21",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-location": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 15000,
    "testMatch": ["**/test/**/*.test.ts", "**/test/**/*.test.tsx"]
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  }
}
